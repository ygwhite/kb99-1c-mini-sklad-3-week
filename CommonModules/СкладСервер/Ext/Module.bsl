Процедура ПроверитьТовары(Документ) Экспорт
    Если Не ЗначениеЗаполнено(Документ.Контрагент) Тогда
        ВызватьИсключение "Укажите контрагента.";
    КонецЕсли;
    Если Документ.Товары.Количество() = 0 Тогда
        ВызватьИсключение "Добавьте хотя бы один товар.";
    КонецЕсли;
    Для Каждого Строка Из Документ.Товары Цикл
        Если Не ЗначениеЗаполнено(Строка.Товар) Тогда
            ВызватьИсключение "В строке не указан товар.";
        КонецЕсли;
        Если Строка.Количество <= 0 Тогда
            ВызватьИсключение "Количество должно быть больше нуля.";
        КонецЕсли;
        Если Строка.Цена < 0 Тогда
            ВызватьИсключение "Цена не может быть отрицательной.";
        КонецЕсли;
        Строка.Сумма = Окр(Строка.Количество * Строка.Цена, 2);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаблокироватьИПроверитьПоследовательность(Документ) Экспорт
    // При редактировании защищаем и старые, и новые товары.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ Товары.Товар КАК Товар ПОМЕСТИТЬ ВТТовары
    |ИЗ &Товары КАК Товары;
    |ВЫБРАТЬ Товары.Товар КАК Товар ИЗ ВТТовары КАК Товары
    |ОБЪЕДИНИТЬ
    |ВЫБРАТЬ Остатки.Товар ИЗ РегистрНакопления.ОстаткиТоваров КАК Остатки
    |ГДЕ Остатки.Регистратор = &Ссылка";
    Запрос.УстановитьПараметр("Товары", Документ.Товары.Выгрузить());
    Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
    Товары = Запрос.Выполнить().Выгрузить();
    Блокировка = Новый БлокировкаДанных;
    Для Каждого ИмяРегистра Из СтрРазделить("ОстаткиТоваров,ПартииТоваров", ",") Цикл
        Элемент = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.ИсточникДанных = Товары;
        Элемент.ИспользоватьИзИсточникаДанных("Товар", "Товар");
    КонецЦикла;
    Блокировка.Заблокировать();
    // Изменение прошлого требует отменить и перепровести последующие документы.
    Запрос.Текст =
    "ВЫБРАТЬ МИНИМУМ(Остатки.Период) КАК Период
    |ИЗ РегистрНакопления.ОстаткиТоваров КАК Остатки
    |ГДЕ Остатки.Регистратор = &Ссылка";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    ДатаПроверки = Документ.Дата;
    Если Выборка.Период <> NULL Тогда
        ДатаПроверки = Мин(ДатаПроверки, Выборка.Период);
    КонецЕсли;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Регистратор КАК Регистратор
    |ИЗ РегистрНакопления.ОстаткиТоваров КАК Остатки
    |ГДЕ Остатки.Товар В (&СписокТоваров)
    | И Остатки.Регистратор <> &Ссылка
    | И (Остатки.Период > &Дата
    | ИЛИ Остатки.Период = &Дата И Остатки.Регистратор > &Ссылка)";
    Запрос.УстановитьПараметр("СписокТоваров", Товары.ВыгрузитьКолонку("Товар"));
    Запрос.УстановитьПараметр("Дата", ДатаПроверки);
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "Есть более поздние движения по товару. Отмените их проведение в обратном порядке, затем проведите документы по хронологии.";
    КонецЕсли;
КонецПроцедуры

Функция Потребность(Документ) Экспорт
    Таблица = Документ.Товары.Выгрузить();
    Таблица.Свернуть("Товар", "Количество,Сумма");
    Возврат Таблица;
КонецФункции

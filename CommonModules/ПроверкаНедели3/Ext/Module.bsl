// Запускается явно параметром /CWeek3Check. Каждый запуск создаёт свои товары.
Функция ВыполнитьПроверку() Экспорт
    Протокол = Новый ТекстовыйДокумент;
    Попытка
        Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
        Контрагент.Наименование = "Проверка недели 3";
        Контрагент.Записать();
        Товар = Справочники.Товары.СоздатьЭлемент();
        Товар.Наименование = "FIFO " + Строка(Новый УникальныйИдентификатор);
        Товар.Записать();
        Первая = Поступление(Товар.Ссылка, Контрагент.Ссылка, Дата(2026,11,1,10,0,0), 10, 100);
        Вторая = Поступление(Товар.Ссылка, Контрагент.Ссылка, Дата(2026,11,2,10,0,0), 5, 120);
        Продажа = Документы.Реализация.СоздатьДокумент();
        Продажа.Дата = Дата(2026,11,3,10,0,0);
        Продажа.Контрагент = Контрагент.Ссылка;
        Строка = Продажа.Товары.Добавить();
        Строка.Товар = Товар.Ссылка;
        Строка.Количество = 8;
        Строка.Цена = 150;
        Строка = Продажа.Товары.Добавить();
        Строка.Товар = Товар.Ссылка;
        Строка.Количество = 4;
        Строка.Цена = 150;
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьИтог(Товар.Ссылка, 3, 360, 12, 1800, 1240);
        Протокол.ДобавитьСтроку("PASS FIFO и повторные строки: 10*100 + 2*120 = 1240; выручка 1800; прибыль 560; остаток 3/360.");
        ПроверитьЧисло(КоличествоДвиженийПартий(Продажа.Ссылка), 2);
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьИтог(Товар.Ссылка, 3, 360, 12, 1800, 1240);
        Протокол.ДобавитьСтроку("PASS повторное проведение: движения не удвоены.");
        Продажа.Товары[0].Количество = 16;
        ОжидатьОтказ(Продажа, РежимЗаписиДокумента.Проведение, "Недостаточно товара");
        ПроверитьИтог(Товар.Ссылка, 3, 360, 12, 1800, 1240);
        Протокол.ДобавитьСтроку("PASS дефицит при перепроведении: прежние движения сохранены во всех регистрах.");
        Продажа = Продажа.Ссылка.ПолучитьОбъект();
        ОжидатьОтказ(Первая, РежимЗаписиДокумента.ОтменаПроведения, "Есть более поздние");
        Первая.Дата = Дата(2026,11,4,10,0,0);
        ОжидатьОтказ(Первая, РежимЗаписиДокумента.Проведение, "Есть более поздние");
        Протокол.ДобавитьСтроку("PASS защита истории: отмена/перенос использованного поступления отклонены.");
        Продажа.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        ПроверитьИтог(Товар.Ссылка, 15, 1600, 0, 0, 0);
        Протокол.ДобавитьСтроку("PASS отмена проведения: остаток 15/1600, продажи очищены.");
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьИтог(Товар.Ссылка, 3, 360, 12, 1800, 1240);
        Продажа.Товары[0].Количество = 0;
        ОжидатьОтказ(Продажа, РежимЗаписиДокумента.Проведение, "Количество должно");
        Продажа = Продажа.Ссылка.ПолучитьОбъект();
        Продажа.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
        ОжидатьОтказ(Продажа, РежимЗаписиДокумента.Проведение, "Укажите контрагента");
        Протокол.ДобавитьСтроку("PASS обязательные поля и положительное количество.");
        Запрос = Новый Запрос("ВЫБРАТЬ КоличествоОстаток КАК Количество ИЗ РегистрНакопления.ПартииТоваров.Остатки(&Дата, Товар = &Товар)");
        Запрос.УстановитьПараметр("Товар", Товар.Ссылка);
        Запрос.УстановитьПараметр("Дата", КонецДня(Дата(2026,11,1)));
        Выборка = Запрос.Выполнить().Выбрать();
        Выборка.Следующий();
        ПроверитьЧисло(Выборка.Количество, 10);
        Протокол.ДобавитьСтроку("PASS остатки на дату: на 1 ноября 10, будущие документы исключены.");
        ПустойТовар = Справочники.Товары.СоздатьЭлемент();
        ПустойТовар.Наименование = "Без движений " + Строка(Новый УникальныйИдентификатор);
        ПустойТовар.Записать();
        Схема = Отчеты.ОстаткиНаДату.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
        Запрос.Текст = Схема.НаборыДанных[0].Запрос + " И Товары.Ссылка = &Товар";
        Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(Дата(2026,11,3)));
        Запрос.УстановитьПараметр("Товар", ПустойТовар.Ссылка);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Не Выборка.Следующий() Тогда ВызватьИсключение "Левое соединение потеряло товар"; КонецЕсли;
        ПроверитьЧисло(Выборка.Количество, 0);
        Протокол.ДобавитьСтроку("PASS левое соединение: товар без движений показан с нулём.");
        // Контроль округления на дробном количестве.
        Округление = Справочники.Товары.СоздатьЭлемент();
        Округление.Наименование = "Округление FIFO";
        Округление.Записать();
        Приход = Поступление(Округление.Ссылка, Контрагент.Ссылка, Дата(2026,11,1,11,0,0), 3, 0.3333);
        // Цена 15.2: используем 3*0.33=0.99, частичное списание 0.5 и остаток 2.5.
        Реализация = Документы.Реализация.СоздатьДокумент();
        Реализация.Контрагент = Контрагент.Ссылка;
        Реализация.Дата = Дата(2026,11,2,11,0,0);
        Строка = Реализация.Товары.Добавить();
        Строка.Товар = Округление.Ссылка; Строка.Количество = 0.5; Строка.Цена = 1;
        Реализация.Записать(РежимЗаписиДокумента.Проведение);
        Реализация2 = Документы.Реализация.СоздатьДокумент();
        Реализация2.Контрагент = Контрагент.Ссылка; Реализация2.Дата = Дата(2026,11,3,11,0,0);
        Строка = Реализация2.Товары.Добавить();
        Строка.Товар = Округление.Ссылка; Строка.Количество = 2.5; Строка.Цена = 1;
        Реализация2.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьИтог(Округление.Ссылка, 0, 0, 3, 3, 0.99);
        Протокол.ДобавитьСтроку("PASS дробное количество и полное списание стоимости без копеечного остатка.");
        Для Каждого ИмяОтчета Из СтрРазделить("ОстаткиНаДату,ПродажиИСебестоимость,ОборотыПоТоварам", ",") Цикл
            Схема = Отчеты[ИмяОтчета].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
            Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
            Макет = Компоновщик.Выполнить(Схема, Схема.ВариантыНастроек[0].Настройки);
            Процессор = Новый ПроцессорКомпоновкиДанных;
            Процессор.Инициализировать(Макет);
            ДокументОтчета = Новый ТабличныйДокумент;
            Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
            Вывод.УстановитьДокумент(ДокументОтчета);
            Вывод.Вывести(Процессор);
            Если ДокументОтчета.ВысотаТаблицы = 0 Тогда ВызватьИсключение "Пустой макет отчёта"; КонецЕсли;
            Протокол.ДобавитьСтроку("PASS формирование СКД " + ИмяОтчета + ".");
        КонецЦикла;
        Протокол.ДобавитьСтроку("SUCCESS: все проверки пройдены на платформе 1С.");
    Исключение
        Протокол.ДобавитьСтроку("FAIL: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Возврат Протокол.ПолучитьТекст();
КонецФункции

Функция Поступление(Товар, Контрагент, ДатаДокумента, Количество, Цена)
    Документ = Документы.Поступление.СоздатьДокумент();
    Документ.Контрагент = Контрагент; Документ.Дата = ДатаДокумента;
    Строка = Документ.Товары.Добавить();
    Строка.Товар = Товар; Строка.Количество = Количество; Строка.Цена = Цена;
    Документ.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Документ;
КонецФункции

Процедура ПроверитьЧисло(Факт, Ожидание)
    Если Факт <> Ожидание Тогда
        ВызватьИсключение СтрШаблон("Ожидалось %1, получено %2", Ожидание, Факт);
    КонецЕсли;
КонецПроцедуры

Процедура ОжидатьОтказ(Документ, Режим, Текст)
    Отклонено = Ложь;
    Попытка
        Документ.Записать(Режим);
    Исключение
        Если СтрНайти(ОписаниеОшибки(), Текст) = 0 Тогда ВызватьИсключение; КонецЕсли;
        Отклонено = Истина;
    КонецПопытки;
    Если Не Отклонено Тогда ВызватьИсключение "Ожидаемый отказ не произошёл"; КонецЕсли;
КонецПроцедуры

Функция КоличествоДвиженийПартий(Ссылка)
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрНакопления.ПартииТоваров ГДЕ Регистратор = &Ссылка");
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

Процедура ПроверитьИтог(Товар, Остаток, Стоимость, Продано, Выручка, Себестоимость)
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Количество, ЕСТЬNULL(СУММА(СтоимостьОстаток), 0) КАК Стоимость ИЗ РегистрНакопления.ПартииТоваров.Остатки(, Товар = &Товар)");
    Запрос.УстановитьПараметр("Товар", Товар);
    Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
    ПроверитьЧисло(Выборка.Количество, Остаток); ПроверитьЧисло(Выборка.Стоимость, Стоимость);
    Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Количество ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар)";
    Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий(); ПроверитьЧисло(Выборка.Количество, Остаток);
    Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОборот), 0) КАК Количество, ЕСТЬNULL(СУММА(СуммаОборот), 0) КАК Сумма, ЕСТЬNULL(СУММА(СебестоимостьОборот), 0) КАК Себестоимость ИЗ РегистрНакопления.Продажи.Обороты(, , , Товар = &Товар)";
    Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
    ПроверитьЧисло(Выборка.Количество, Продано); ПроверитьЧисло(Выборка.Сумма, Выручка); ПроверитьЧисло(Выборка.Себестоимость, Себестоимость);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    СкладСервер.ПроверитьТовары(ЭтотОбъект);
    СкладСервер.ЗаблокироватьИПроверитьПоследовательность(ЭтотОбъект);
    // При отказе очистка прежних движений откатывается вместе с проведением.
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ПартииТоваров.Записывать = Истина;
    Движения.Продажи.Записывать = Истина;
    Движения.ОстаткиТоваров.Очистить();
    Движения.ПартииТоваров.Очистить();
    Движения.Продажи.Очистить();
    Движения.Записать();
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ПартииТоваров.Записывать = Истина;
    Движения.Продажи.Записывать = Истина;
    Потребность = СкладСервер.Потребность(ЭтотОбъект);
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ Остатки.Товар КАК Товар, Остатки.Партия КАК Партия,
    | Остатки.КоличествоОстаток КАК Количество,
    | Остатки.СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ПартииТоваров.Остатки(
    | &Граница, Товар В (&Товары)) КАК Остатки
    |ГДЕ Остатки.КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО Остатки.Партия.Дата, Остатки.Партия";
    Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Товары", Потребность.ВыгрузитьКолонку("Товар"));
    Партии = Запрос.Выполнить().Выгрузить();
    Для Каждого Строка Из Потребность Цикл
        ОсталосьСписать = Строка.Количество;
        Себестоимость = 0;
        Для Каждого Партия Из Партии.НайтиСтроки(Новый Структура("Товар", Строка.Товар)) Цикл
            Если ОсталосьСписать = 0 Тогда
                Прервать;
            КонецЕсли;
            КоличествоПартии = Мин(ОсталосьСписать, Партия.Количество);
            // При полном списании забираем стоимость целиком, включая округление.
            Если КоличествоПартии = Партия.Количество Тогда
                СтоимостьПартии = Партия.Стоимость;
            Иначе
                СтоимостьПартии = Окр(Партия.Стоимость * КоличествоПартии / Партия.Количество, 2);
            КонецЕсли;
            Движение = Движения.ПартииТоваров.ДобавитьРасход();
            Движение.Период = Дата;
            Движение.Товар = Строка.Товар;
            Движение.Партия = Партия.Партия;
            Движение.Количество = КоличествоПартии;
            Движение.Стоимость = СтоимостьПартии;
            Себестоимость = Себестоимость + СтоимостьПартии;
            ОсталосьСписать = ОсталосьСписать - КоличествоПартии;
        КонецЦикла;
        Если ОсталосьСписать > 0 Тогда
            ВызватьИсключение СтрШаблон("Недостаточно товара %1: не хватает %2.", Строка.Товар, ОсталосьСписать);
        КонецЕсли;
        Остаток = Движения.ОстаткиТоваров.ДобавитьРасход();
        Остаток.Период = Дата;
        Остаток.Товар = Строка.Товар;
        Остаток.Количество = Строка.Количество;
        Продажа = Движения.Продажи.Добавить();
        Продажа.Период = Дата;
        Продажа.Товар = Строка.Товар;
        Продажа.Количество = Строка.Количество;
        Продажа.Сумма = Строка.Сумма;
        Продажа.Себестоимость = Себестоимость;
    КонецЦикла;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    СкладСервер.ЗаблокироватьИПроверитьПоследовательность(ЭтотОбъект);
КонецПроцедуры

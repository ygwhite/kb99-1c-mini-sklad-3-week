// Адаптация сеанса отдельной учебной демобазы, без изменения учётных записей и прав.
Процедура УстановкаПараметровСеанса(ИменаПараметровСеанса)
    Имя = ИмяПользователя();
    Если ПустаяСтрока(Имя) Тогда Имя = "Практика недели 3"; КонецЕсли;
    Пользователь = Справочники.Пользователи.НайтиПоНаименованию(Имя);
    Если Не ЗначениеЗаполнено(Пользователь) Тогда
        ОбъектПользователя = Справочники.Пользователи.СоздатьЭлемент();
        ОбъектПользователя.Наименование = Имя;
        ОбъектПользователя.Записать();
        Пользователь = ОбъектПользователя.Ссылка;
    КонецЕсли;
    ПараметрыСеанса.ТекущийПользователь = Пользователь;
    ПараметрыСеанса.ПараметрыКлиентаНаСервере = Новый ФиксированноеСоответствие(Новый Соответствие);
КонецПроцедуры

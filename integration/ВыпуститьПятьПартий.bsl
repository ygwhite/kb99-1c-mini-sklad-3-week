// Повторный запуск получает результат существующих заявок и не дублирует выпуск.
Функция НастроитьИПроверить() Экспорт
    Протокол = Новый ТекстовыйДокумент;
    Попытка
        Пользователь = Справочники.Пользователи.НайтиПоНаименованию("Практика недели 3");
        Если Не ЗначениеЗаполнено(Пользователь) Тогда
            ПользовательОбъект = Справочники.Пользователи.СоздатьЭлемент();
            ПользовательОбъект.Наименование = "Практика недели 3";
            ПользовательОбъект.Записать(); Пользователь = ПользовательОбъект.Ссылка;
        КонецЕсли;
        ПараметрыСеанса.ТекущийПользователь = Пользователь;
        Параметры = ВетИС_ЯдроСервер.ЗагрузитьПараметры(Справочники.Организации.ОсновнаяОрганизация);
        Отправка = кб99_ВСД_Отправка.ПараметрыОтправкиИнициализация(Параметры);
        Если Отправка.Адрес <> "api2.vetrf.ru" Или Отправка.Порт <> 8002 Тогда
            ВызватьИсключение "Разрешён только тестовый контур Ветис";
        КонецЕсли;
        ХС = Справочники.ВСД_ХозСубъект.НайтиПоРеквизиту("GUID", Параметры.param_issuer_id);
        Площадка = Справочники.ВСД_Площадка.НайтиПоРеквизиту("GUID", "aec24873-ab51-4c3f-870f-01371347258a");
        Элемент = Справочники.ВСД_Продукция_Элемент.НайтиПоРеквизиту("GUID", "fc8dd0c8-e89b-46fa-af09-3055a68d3fed");
        Единица = Справочники.ВСД_ЕдиницыИзмерения.НайтиПоРеквизиту("GUID", "6606dc4a-d415-4e19-8acd-01c6d4a89e18");
        Если Не ЗначениеЗаполнено(ХС) Или Не ЗначениеЗаполнено(Площадка) Или Не ЗначениеЗаполнено(Элемент) Или Не ЗначениеЗаполнено(Единица) Тогда
            ВызватьИсключение "Выполните загрузку реквизитов продукции и площадки";
        КонецЕсли;
        Параметры.Вставить("Отправитель_Площадка", Площадка);
        Параметры.Вставить("ПаузаСек", 1);
        Для НомерПартии = 1 По 5 Цикл
            Комментарий = "Практика неделя 3 партия " + Строка(НомерПартии);
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ВСД2_Производство ГДЕ ВЫРАЗИТЬ(Комментарий КАК СТРОКА(100)) = &Комментарий");
            Запрос.УстановитьПараметр("Комментарий", Комментарий);
            Существующий = Запрос.Выполнить().Выбрать();
            Если Существующий.Следующий() Тогда Документ = Существующий.Ссылка.ПолучитьОбъект();
            Иначе Документ = Документы.ВСД2_Производство.СоздатьДокумент(); КонецЕсли;
            Последний = ВетИС_УтилитыКлиентСервер.НайтиПоследнийЗапрос(Документ.Ссылка);
            БылаОтправка = Ложь;
            Если Последний.СтатусЗапросаПеречисление = Перечисления.кб99_СтатусЗапроса.COMPLETED Тогда
                Протокол.ДобавитьСтроку(Комментарий + ": уже COMPLETED");
            Иначе
                БылаОтправка = Истина;
                Если Последний.СтатусЗапросаПеречисление = Перечисления.кб99_СтатусЗапроса.ACCEPTED Или Последний.СтатусЗапросаПеречисление = Перечисления.кб99_СтатусЗапроса.IN_PROCESS Тогда
                    Если Не ЗначениеЗаполнено(Последний.ApplicationID) Тогда
                        // Ответ submit потерян. Сохраняем тот же документ и тот же
                        // localTransactionId: сервер исключает повторную обработку.
                        ПараметрыФункции = Новый Структура("Параметры,ДокОснование,ПолучитьОтветВетис", Параметры, Документ.Ссылка, Истина);
                        ПараметрыФункции.Вставить("ЗапросXML", ВетИС_API_ТранзакцииСервер.ВСД2_производство_ЗапросXML(Параметры, Документ.Ссылка));
                        Статус = ВетИС_API_ТранзакцииСервер.ОтправитьЗапрос(ПараметрыФункции);
                    Иначе
                        ПараметрыФункции = Новый Структура("Параметры,ДокОснование,ApplicationID", Параметры, Документ.Ссылка, Последний.ApplicationID);
                        Статус = ВетИС_API_ТранзакцииСервер.ПолучитьРезультат_ВСД2(ПараметрыФункции);
                    КонецЕсли;
                Иначе
                    Документ.Дата = ТекущаяДатаСеанса();
                    Документ.Организация = Параметры.Организация;
                    Документ.Производитель_Площадка = Площадка;
                    Документ.Производитель_ХозСубъект = ХС;
                    Документ.Комментарий = Комментарий;
                    Документ.ЗавершитьОперацию = Истина;
                    Документ.cargoInspected = Истина;
                    Документ.РезультатыИсследований = Перечисления.кб99_РезультатИсследования.VSERAW;
                    Документ.Продукция.Очистить();
                    СтрокаПродукции = Документ.Продукция.Добавить();
                    СтрокаПродукции.Продукция_Элемент = Элемент;
                    СтрокаПродукции.Продукция = Элемент.Продукция;
                    СтрокаПродукции.ВидПродукции = Элемент.ВидПродукции;
                    СтрокаПродукции.НаименованиеПродукции = Элемент.Наименование;
                    СтрокаПродукции.Количество = НомерПартии * 10;
                    СтрокаПродукции.ЕдиницаИзмерения = Единица;
                    СтрокаПродукции.ДатаИзготовления1 = НачалоДня(ТекущаяДатаСеанса());
                    СтрокаПродукции.ДатаСрокГодности1 = НачалоДня(ТекущаяДатаСеанса()) + 25 * 86400;
                    СтрокаПродукции.НомерПартии = "W3-20261108-0" + Строка(НомерПартии);
                    СтрокаПродукции.КлючСтроки = Новый УникальныйИдентификатор;
                    Документ.Записать();
                    ПараметрыФункции = Новый Структура("Параметры,ДокОснование,ПолучитьОтветВетис", Параметры, Документ.Ссылка, Истина);
                    ПараметрыФункции.Вставить("СписокПартий", Новый Массив);
                    Прогресс("Отправляется " + Комментарий);
                    Статус = ВетИС_API_ТранзакцииСервер.ВСД2_Производство_Отправить(ПараметрыФункции);
                КонецЕсли;
                Протокол.ДобавитьСтроку(Комментарий + ": " + Строка(Статус));
            КонецЕсли;
            Последний = ВетИС_УтилитыКлиентСервер.НайтиПоследнийЗапрос(Документ.Ссылка);
            Протокол.ДобавитьСтроку("Документ=" + Строка(Документ.Ссылка) + "; ApplicationID=" + Строка(Последний.ApplicationID) + "; статус=" + Строка(Последний.СтатусЗапросаПеречисление));
            Если ЗначениеЗаполнено(Последний.Ошибки) Тогда Протокол.ДобавитьСтроку("Ошибки=" + Строка(Последний.Ошибки)); КонецЕсли;
            Для Каждого Результат Из Документ.Ссылка.ПартииРезультат Цикл
                Протокол.ДобавитьСтроку("Партия GUID=" + Результат.Партия.GUID + "; UUID=" + Результат.Партия.UUID + "; количество=" + Строка(Результат.Количество));
            КонецЦикла;
            СохранитьПротокол(Протокол);
            Если Последний.СтатусЗапросаПеречисление <> Перечисления.кб99_СтатусЗапроса.COMPLETED Тогда
                ВызватьИсключение "Выпуск не подтверждён, дальнейшие партии не отправлялись";
            КонецЕсли;
            // Один выпуск на сеанс: снижаем число последовательных запросов
            // к нестабильному тестовому серверу. Остальные продолжит следующий запуск.
            Если БылаОтправка Тогда Прервать; КонецЕсли;
        КонецЦикла;
        Если НомерПартии >= 5 Тогда
            Протокол.ДобавитьСтроку("SUCCESS: пять партий подтверждены тестовым Меркурием");
        Иначе
            Протокол.ДобавитьСтроку("Обработана одна операция, следующий запуск продолжит выпуск.");
        КонецЕсли;
    Исключение
        Протокол.ДобавитьСтроку("FAIL: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    СохранитьПротокол(Протокол);
    Возврат Протокол.ПолучитьТекст();
КонецФункции

Процедура Прогресс(Текст)
    Файл = Новый ТекстовыйДокумент; Файл.УстановитьТекст(Текст);
    Файл.Записать("D:\PROGRAMING\PROJECTS\1C\validation\week3\vetis-progress.txt", КодировкаТекста.UTF8);
КонецПроцедуры

Процедура СохранитьПротокол(Протокол)
    Протокол.Записать("D:\PROGRAMING\PROJECTS\1C\validation\week3\batches-results.txt", КодировкаТекста.UTF8);
КонецПроцедуры

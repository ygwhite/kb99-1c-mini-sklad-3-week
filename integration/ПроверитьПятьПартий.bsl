Функция НастроитьИПроверить() Экспорт
    Протокол = Новый ТекстовыйДокумент;
    Данные = Новый Массив;
    Попытка
        Для Номер = 1 По 5 Цикл
            Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ВСД2_Производство ГДЕ ВЫРАЗИТЬ(Комментарий КАК СТРОКА(100)) = &Комментарий");
            Запрос.УстановитьПараметр("Комментарий", "Практика неделя 3 партия " + Строка(Номер));
            Выборка = Запрос.Выполнить().Выбрать();
            Если Не Выборка.Следующий() Тогда ВызватьИсключение "Отсутствует документ производства"; КонецЕсли;
            Документ = Выборка.Ссылка;
            Заявка = ВетИС_УтилитыКлиентСервер.НайтиПоследнийЗапрос(Документ);
            Если Заявка.СтатусЗапросаПеречисление <> Перечисления.кб99_СтатусЗапроса.COMPLETED Тогда
                ВызватьИсключение "Заявка не завершена";
            КонецЕсли;
            Запрос.Текст = "ВЫБРАТЬ Ссылка, GUID, UUID, Количество, vetDocument.UUID КАК UUIDВСД ИЗ Справочник.ВСД_Партия ГДЕ ДокОснование = &Документ И НЕ ПометкаУдаления";
            Запрос.УстановитьПараметр("Документ", Документ);
            Партии = Запрос.Выполнить().Выбрать();
            Если Не Партии.Следующий() Тогда ВызватьИсключение "Для документа не загружена партия"; КонецЕсли;
            Если Партии.Количество <> Номер * 10 Тогда ВызватьИсключение "Неверный объём партии"; КонецЕсли;
            Если ПустаяСтрока(Партии.GUID) Или ПустаяСтрока(Партии.UUID) Или ПустаяСтрока(Партии.UUIDВСД) Тогда
                ВызватьИсключение "Не заполнены идентификаторы результата";
            КонецЕсли;
            Если Не Документ.Проведен Тогда ВызватьИсключение "Документ не проведён"; КонецЕсли;
            СтрокаДанных = Новый Структура;
            СтрокаДанных.Вставить("batch", Номер);
            СтрокаДанных.Вставить("document", Строка(Документ.Номер));
            СтрокаДанных.Вставить("date", Формат(Документ.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"));
            СтрокаДанных.Вставить("quantity", Партии.Количество);
            СтрокаДанных.Вставить("applicationId", Заявка.ApplicationID);
            СтрокаДанных.Вставить("stockGuid", Партии.GUID);
            СтрокаДанных.Вставить("stockUuid", Партии.UUID);
            СтрокаДанных.Вставить("certificateUuid", Партии.UUIDВСД);
            СтрокаДанных.Вставить("status", "COMPLETED");
            Данные.Добавить(СтрокаДанных);
            Протокол.ДобавитьСтроку("PASS партия " + Строка(Номер) + ": " + Строка(Партии.Количество) + " шт.; ApplicationID=" + Заявка.ApplicationID + "; StockGUID=" + Партии.GUID + "; ВСД=" + Партии.UUIDВСД);
        КонецЦикла;
        Запись = Новый ЗаписьJSON;
        Запись.ОткрытьФайл("D:\PROGRAMING\PROJECTS\1C\validation\week3\batches.json");
        ЗаписатьJSON(Запись, Данные); Запись.Закрыть();
        Протокол.ДобавитьСтроку("SUCCESS: 5 проведённых документов, 5 завершённых заявок, 5 партий и ВСД, 150 шт.");
    Исключение
        Протокол.ДобавитьСтроку("FAIL: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Протокол.Записать("D:\PROGRAMING\PROJECTS\1C\validation\week3\verification-results.txt", КодировкаТекста.UTF8);
    Возврат Протокол.ПолучитьТекст();
КонецФункции
